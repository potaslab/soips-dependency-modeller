{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soips:dependency-model:1.0.0",
  "title": "Domain-neutral dependency model 1.0.0",
  "type": "object",
  "required": ["schemaVersion", "modelId", "metadata", "categories", "nodes", "relations", "view"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "modelId": {"$ref": "#/$defs/id"},
    "metadata": {
      "type": "object", "required": ["title", "authors", "description", "version"],
      "properties": {
        "title": {"$ref": "#/$defs/id"}, "authors": {"$ref": "#/$defs/textArray"},
        "description": {"type": "string"}, "version": {"type": "string"},
        "year": {"type": "integer", "minimum": 0}, "citation": {"type": ["string", "null"]},
        "sourceUrl": {"type": ["string", "null"]}, "licence": {"type": "string"},
        "created": {"type": "string"}, "updated": {"type": "string"},
        "researchReady": {"type": "boolean"}, "modificationNotes": {"type": "string"}
      }
    },
    "categories": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/category"}},
    "nodes": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/node"}},
    "relations": {"type": "array", "maxItems": 20000, "items": {"$ref": "#/$defs/relation"}},
    "view": {
      "type": "object", "properties": {
        "defaultRoot": {"type": "string"}, "visibleRelations": {"type": "array", "items": {"$ref": "#/$defs/kind"}},
        "zoom": {"type": "number", "minimum": 0.1, "maximum": 4}, "includeCredit": {"type": "boolean"}
      }
    },
    "analysisSettings": {
      "type": "object", "properties": {
        "maxStates": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "maxConfigurations": {"type": "integer", "minimum": 1, "maximum": 10000},
        "timeoutMs": {"type": "integer", "minimum": 1, "maximum": 5000}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "\\S"},
    "textArray": {"type": "array", "items": {"type": "string"}},
    "colour": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
    "kind": {"enum": ["defining", "oneOf", "supports", "requiredVia", "canBuildOn", "participation"]},
    "category": {
      "type": "object", "required": ["id", "label", "colour", "description", "order"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/id"},
        "colour": {"$ref": "#/$defs/colour"}, "fill": {"$ref": "#/$defs/colour"},
        "description": {"type": "string"}, "order": {"type": "number"}, "band": {"type": "boolean"},
        "labelSpace": {"type": "number", "minimum": 0, "maximum": 1000}
      }
    },
    "node": {
      "type": "object", "required": ["id", "label", "categoryId", "description", "order"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/id"},
        "categoryId": {"$ref": "#/$defs/id"}, "description": {"type": "string"}, "order": {"type": "number"},
        "shortLabel": {"type": "string"}, "code": {"type": "string"}, "notes": {"type": "string"},
        "references": {"$ref": "#/$defs/textArray"},
        "position": {"type": "object", "required": ["x", "y"], "properties": {"x": {"type": "number", "minimum": 0, "maximum": 100000}, "y": {"type": "number", "minimum": 0, "maximum": 100000}}},
        "width": {"type": "number", "minimum": 20, "maximum": 2000}, "height": {"type": "number", "minimum": 20, "maximum": 2000}
      }
    },
    "relation": {
      "type": "object", "required": ["id", "from", "to", "kind", "explanation", "evidence", "judgement"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "from": {"$ref": "#/$defs/id"}, "to": {"$ref": "#/$defs/id"},
        "kind": {"$ref": "#/$defs/kind"}, "groupId": {"$ref": "#/$defs/id"}, "via": {"$ref": "#/$defs/id"},
        "condition": {"type": "object", "required": ["allOf"], "properties": {"allOf": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}}},
        "context": {"type": "string"}, "explanation": {"type": "string"},
        "evidence": {"$ref": "#/$defs/textArray"}, "judgement": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "oneOf"}}}, "then": {"required": ["groupId"]}},
        {"if": {"properties": {"kind": {"const": "requiredVia"}}}, "then": {"required": ["via"]}},
        {"if": {"properties": {"kind": {"const": "participation"}}}, "then": {"required": ["condition", "context"], "properties": {"context": {"$ref": "#/$defs/id"}}}}
      ]
    }
  }
}
